<!-- HOW IT WORKS -->
<section class="section" id="how">
  <div class="section-header">
    <div class="section-number">01 —</div>
    <h2 class="section-title">How TermsDecoded Works</h2>
  </div>
  <div class="steps">
    <div class="step">
      <span class="step-num">01</span>
      <div class="step-title">Paste the Agreement</div>
